# Credenciais do R2 (Cloudflare) usadas por `main.py sync`.
# Copie este arquivo para `.env` e preencha com os valores reais.
# Nunca commite o `.env` (já está no .gitignore).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Google Drive Shared Drive (usado por `main.py drive-sync`).
# SA pipeline-drive-bdtd@drive-bdtd.iam.gserviceaccount.com deve ser
# Gerenciador de conteudo no Shared Drive.
# Veja EQUIPE_DRIVE.md para instrucoes completas.
GOOGLE_APPLICATION_CREDENTIALS=~/.config/pipeline-bdtd/sa-key.json
# alternativa: GDRIVE_CREDENTIALS_PATH=secrets/drive-bdtd-sa.json
GDRIVE_FOLDER_ID=1UImdu0YmqoPd8ulwHfDUIMaHBAuIq_N8
GDRIVE_SHARED_DRIVE_ID=
# opcional fallback local
# GDRIVE_CREDENTIALS_PATH=
